{
  "expo": {
    "name": "PhotoOS",
    "slug": "photoos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/PhotoOS-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.photoos.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F589B",
        "foregroundImage": "./assets/PhotoOS-app-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/PhotoOS-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.photoos.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/PhotoOS-favicon.png"
    },
    "scheme": "photoos",
    "plugins": [
      "expo-camera",
      "@react-native-community/datetimepicker"
    ],
    "favicon": "./assets/PhotoOS-favicon.png",
    "extra": {
      "eas": {
        "projectId": "fc1266a0-225f-4e58-83fd-d119c7d59a53"
      }
    }
  }
}

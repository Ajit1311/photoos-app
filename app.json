{
  "expo": {
    "name": "PhotoOS",
    "slug": "photoos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/PhotoOS-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.photoos.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F589B",
        "foregroundImage": "./assets/PhotoOS-app-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/PhotoOS-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.photoos.app"
    },
    "web": {
      "favicon": "./assets/PhotoOS-favicon.png"
    },
    "scheme": "photoos",
    "plugins": [
      "expo-camera",
      "@react-native-community/datetimepicker"
    ],
    "favicon": "./assets/PhotoOS-favicon.png"
  }
}
